# Configurações do Supabase para Sincronização em Nuvem (WebGIS)
# Suporta os nomes site_suba / suba_anon ou VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
site_suba="https://seu-projeto.supabase.co"
suba_anon="sua_chave_anon_publica"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anon_publica"

# Porta do Servidor Node (Opcional, padrão: 3000)
PORT=3000
