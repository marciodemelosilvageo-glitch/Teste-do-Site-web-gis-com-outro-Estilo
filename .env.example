# Configurações do Supabase para Sincronização em Nuvem (WebGIS)
# Substitua pelos dados do seu projeto Supabase (painel Settings -> API)
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_CHAVE_ANON"
site_suba="https://SEU_PROJETO.supabase.co"
suba_anon="SUA_CHAVE_ANON"

# Chave pública da API do CARTO (Mapas Base)
VITE_CARTO_KEY="SUA_CHAVE_CARTO"

# Porta do Servidor Node (Opcional, padrão: 3000)
PORT=3000
